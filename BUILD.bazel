"""MiniStack, the AWS emulator the ERP's Amazon Services Dev Services run, built by rules_py and
packaged by rules_img on UBI 10's minimal image (the base the RDP proxy's image uses too).

The image is loaded as ministack:<digest> (:image_load), the name the Dev Services start it by
(quarkus.aws.devservices.ministack.image-name): dev mode once dev.sh has run :image_load, an
application test once the dev_services_test it runs under (//web/jvm/images:defs.bzl) has.
"""

load("@aspect_rules_py//py:defs.bzl", "py_image_layer", "py_library")
load("@aspect_rules_py//py/unstable:defs.bzl", "py_venv_binary")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img_images.bzl", "image")

py_library(
    name = "ministack_lib",
    srcs = glob(["ministack/**/*.py"]),
    imports = ["."],
    deps = [
        "@ministack_pypi//botocore",
        "@ministack_pypi//cryptography",
        "@ministack_pypi//defusedxml",
        "@ministack_pypi//graphql_core",
        "@ministack_pypi//hypercorn",
        "@ministack_pypi//jsonata_python",
        "@ministack_pypi//pyyaml",
    ],
)

# The server, as the upstream image runs it (`python -m ministack`), in the virtualenv of the
# hub's `server` dependency group, which rules_py assembles at build time rather than at start.
# Not named after the package: the binary's runfiles hold its sources' ministack/ directory at
# the path a binary of that name would take.
py_venv_binary(
    name = "server",
    srcs = ["ministack/__main__.py"],
    main = "ministack/__main__.py",
    python_version = "3.14",
    venv = "server",
    deps = [":ministack_lib"],
)

# The binary under /vendor/ministack, split into its interpreter's layer, its packages' and its
# own sources'. The runfiles hold a symlink and its target as two files (the interpreter's python,
# python3 and python3.14; its libpython3.14.so and libpython3.14.so.1.0), so each layer is rewritten
# with identical files hardlinked, leaving one copy of each. The rewrite compresses the layers, so
# their tars are left uncompressed.
#
# The interpreter's executable is statically linked, as are python-build-standalone's: its shared
# library is only for embedding the interpreter in another program, so it is grouped into a layer
# of its own, which the image leaves out.
EMBEDDING_LAYER = "layers_embedding"

LAYERS = py_image_layer(
    name = "layers",
    binary = ":server",
    compress = "",
    layer_groups = {"embedding": "/lib/libpython3[.]14[.]so"},
)

[
    layer_from_tar(
        name = layer + "_deduplicated",
        src = layer,
        optimize = True,
    )
    for layer in LAYERS
    if layer != EMBEDDING_LAYER
]

image_manifest(
    name = "image",
    base = image("ubi_minimal"),
    config_fragment = "//vendor/ministack/bazel:image_config.json",
    entrypoint = ["/" + package_name() + "/server"],
    # The upstream image's settings for the server: the one port every service answers on, and
    # unbuffered output, so its log reaches the container's as it is written.
    env = {
        "GATEWAY_PORT": "4566",
        "MINISTACK_VERSION": "1.5.29-erp",
        "PYTHONUNBUFFERED": "1",
    },
    layers = [layer + "_deduplicated" for layer in LAYERS if layer != EMBEDDING_LAYER],
    platform = "//vendor/ministack/bazel:linux_x86_64_glibc",
)

# The digest of the image's manifest, which the tests and dev.sh name the image by.
filegroup(
    name = "image_digest",
    srcs = [":image"],
    output_group = "digest",
    visibility = ["//web/jvm/images:__pkg__"],
)

# Loads the image into the local container runtime as ministack:<digest>, so the name always
# means the image this build made. Its layers are in its runfiles (eager), not fetched from the
# remote cache at load, and the loader is built for the target platform, so an application test
# that has it as data runs it in the test's own environment.
image_load(
    name = "image_load",
    image = ":image",
    strategy = "eager",
    # Fully qualified: Docker's containerd image store hides a loaded name that is not, and
    # resolves the Dev Services' ministack:<digest> to this one.
    tag = "docker.io/library/ministack:{{slice .digest 7}}",
    tool_cfg = "target",
    tracks_content = True,
    visibility = ["//web/jvm/images:__pkg__"],
)
