exports_files([
    "image_config.json",
    "pyproject.toml",
    "uv.lock",
])

# The platform the image runs on: x86_64 Linux on UBI 10's glibc (2.39), against which the uv
# hub chooses each package's manylinux wheel. The interpreter leaves out what a server never
# runs: C headers and build configuration, documentation, the GUI and its editor, pip's
# bootstrapper, pydoc's templates, and the Python 2 converter.
platform(
    name = "linux_x86_64_glibc",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    flags = [
        "--@aspect_rules_py//uv/private/constraints/platform:platform_libc=glibc",
        "--@aspect_rules_py//uv/private/constraints/platform:platform_version=2.39",
    ] + [
        "--@aspect_rules_py//py/private/interpreter:exclude_feature=" + feature
        for feature in [
            "config",
            "docs",
            "ensurepip",
            "headers",
            "idle",
            "lib2to3",
            "pydoc",
            "tkinter",
            "turtle",
        ]
    ],
    visibility = ["//vendor/ministack:__pkg__"],
)
