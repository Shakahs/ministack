exports_files([
    "image_config.json",
    "pyproject.toml",
    "uv.lock",
])

# The platform the image runs on: x86_64 Linux on UBI 10's glibc (2.39), against which the uv
# hub chooses each package's manylinux wheel.
platform(
    name = "linux_x86_64_glibc",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    flags = [
        "--@aspect_rules_py//uv/private/constraints/platform:platform_libc=glibc",
        "--@aspect_rules_py//uv/private/constraints/platform:platform_version=2.39",
    ],
    visibility = ["//vendor/ministack:__pkg__"],
)
